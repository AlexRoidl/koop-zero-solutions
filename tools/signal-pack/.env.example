# Copy this file to ".env" and fill in your Signal credentials.
# Read them from Signal Desktop (see README.md): DevTools -> Electron Isolated
# Context -> window.reduxStore.getState().items.uuid_id / .password
# The .env file is git-ignored and stays only on your machine.

SIGNAL_USER=
SIGNAL_PASSWORD=

# Optional overrides:
# MEMES_URL=https://koop.zero-solutions.solutions
# PACK_TITLE=Koop Memes
# PACK_AUTHOR=Symposium Kooperation
# PACK_EMOJI=😂
